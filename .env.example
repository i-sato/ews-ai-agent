# Hanya nama variabel. Isi di .env.local (lokal) atau environment Vercel. Jangan commit nilai asli.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server saja. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Spreadsheet ID dan gid disimpan per pelatihan di tabel data_sources, bukan di env.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_REPORT_SHARED_DRIVE_ID=
GOOGLE_PK_FOLDER_ID=
REPORT_IMAGE_URL_TTL_SECONDS=300

AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=
GEMINI_API_KEY=
AI_MONTHLY_BUDGET_USD=

CRON_SECRET=

# Impor (F2-07): wajib diisi; angka diputuskan di F2-08/Pengaturan (docs/decisions.md).
IMPORT_STAGING_TTL_MINUTES=
MANUAL_SYNC_MIN_INTERVAL_MINUTES=
